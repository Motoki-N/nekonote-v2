# Supabase プロジェクト設定（Dashboard > Settings > API）
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 許可メールアドレス（カンマ区切り）。未設定時は全ユーザー拒否（フェイルクローズ）
# DB側の private.auth_allowlist テーブル（マイグレーションで設定）と手動で同期すること
ALLOWED_EMAILS=motoking55@gmail.com

# AIプロバイダのAPIキー（lib/ai/models.ts の PROVIDER_ENV_KEY と対応）
# 未設定のプロバイダは設定画面に「APIキー未設定」バッジが出て、呼び出し時はエラーになる
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# ノート等の暗号化キー
ENCRYPTION_KEY=

# マイルストーン締切リマインド（Issue #51）: cron から全ユーザーのプロジェクトを
# 読み書きするための service_role キー（Dashboard > Settings > API）。
# 絶対にクライアントへ露出しないこと（NEXT_PUBLIC_ を付けない）
SUPABASE_SERVICE_ROLE_KEY=

# メール送信（Resend）とcronエンドポイントの認証
RESEND_API_KEY=
# 送信元アドレス（Resendで検証済みドメインが未設定なら空のままでonboarding@resend.devを使う）
REMINDER_FROM_EMAIL=
# Vercel Cron が自動付与する Authorization: Bearer ヘッダーと突き合わせる値
CRON_SECRET=
